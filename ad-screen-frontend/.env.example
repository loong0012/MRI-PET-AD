# ============================================================
# ADScreen 前端环境变量示例（Vite）
# 复制为 .env.development（开发）或 .env.production（生产）后按需修改
# ============================================================

# 后端接口基础路径：为空时走 vite proxy 的 /api（开发默认）
# 生产部署直接填后端完整地址，如 https://api.your-hospital.com
VITE_API_BASE=/api

# 是否使用内置 Mock 数据
# true:  演示模式，无需后端即可运行全部页面（适合功能演示）
# false: 对接真实后端
VITE_USE_MOCK=false

# 应用版本号（登录页展示）
VITE_APP_VERSION=1.0.0
