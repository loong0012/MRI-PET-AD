# ============================================================
# ADScreen 后端环境变量示例
# 复制为 .env 后按需修改；生产部署务必通过环境变量注入敏感配置
# ============================================================

# 运行环境：development（宽松校验，便于本地开发）/ production（强制安全校验）
ADSCREEN_ENV=development

# JWT 密钥：开发可留空（使用内置默认密钥）；生产环境必须设置 ≥32 字符的高强度随机串
ADSCREEN_SECRET_KEY=

# SQLite 数据库路径：留空则使用 ad-screen-backend/ad_screen.db
ADSCREEN_DB_PATH=

# 跨域白名单：逗号分隔的域名，留空则开发环境允许 localhost
# 生产示例：https://your-hospital-domain
ADSCREEN_CORS_ORIGINS=

# JWT Token 过期时间（分钟），默认 720 = 12 小时
ADSCREEN_TOKEN_EXPIRE_MINUTES=720

# 登录防爆破：连续失败 N 次后锁定
ADSCREEN_LOGIN_MAX_FAILS=5
# 锁定时长（分钟）
ADSCREEN_LOGIN_LOCK_MINUTES=15

# 日志目录：留空则使用 ad-screen-backend/logs
ADSCREEN_LOG_DIR=
# 日志级别：DEBUG / INFO / WARNING / ERROR
ADSCREEN_LOG_LEVEL=INFO

# DICOM UID 根：DICOMweb 对外导出研究/序列/实例 UID 时使用。
# 生产部署前必须替换为本院已申请的 OID 根，否则 UID 可能与其他机构冲突。
# 未设置时使用占位根，启动日志会告警。
ADSCREEN_DICOM_UID_ROOT=

# ---------- 合规审计 ----------
# 审计日志保留天数（HIPAA 要求至少 6 年 = 2190 天）。设为 0 表示永久保留。
# 注意：清理为管理员显式触发，系统不会自动删除。
ADSCREEN_AUDIT_RETENTION_DAYS=2190
# 是否启用自动审计中间件（1/0）。关闭后仅保留手工埋点。
ADSCREEN_AUDIT_ENABLED=1
